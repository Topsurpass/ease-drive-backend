# Copy to .env and fill in. .env is gitignored; never commit a real credential.
# Defaults for everything here live in app/core/config.py.

# ---- Database (required by any route that persists) ----
# Neon Postgres connection string. Unprefixed on purpose: Neon, Vercel, Render
# and Railway all inject this exact name, so the app reads it as-is.
# Without it the app still starts, /api/v1/health reports "degraded", and
# POST /api/v1/bookings returns 503 instead of crashing.
#
# Either endpoint works. The pooled one (-pooler in the host) is the default
# choice; the app detects it and disables asyncpg's prepared-statement cache,
# which PgBouncer's transaction mode cannot reuse safely.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"

# ---- Auth (required by the ops console) ----
# Signing key for access tokens, and the key the refresh-token chain is derived
# from. Generate a fresh one per environment:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# There is no default and there never will be: a fallback secret is a published
# secret, and every unconfigured deploy would share it. Must be at least 32
# bytes (RFC 7518 §3.2) or the app refuses to start.
#
# Without it the app still boots, startup logs a warning, and every /auth route
# returns 503 rather than signing tokens nobody can trust.
#
# Rotating this signs everyone out: live access tokens stop verifying and
# refresh chains stop deriving. That is what you want after a compromise, and
# not something to do casually.
EASE_DRIVE_JWT_SECRET=

# ---- Application (optional; all have defaults) ----
# EASE_DRIVE_PROJECT_NAME="Ease Drive API"
# EASE_DRIVE_VERSION="0.1.0"
# EASE_DRIVE_API_V1_PREFIX="/api/v1"
# EASE_DRIVE_GREETING="Hello, World!"
#
# Session tuning. Defaults are 15 min access, 14 day refresh, 30s grace.
# EASE_DRIVE_ACCESS_TOKEN_TTL_SECONDS=900
# EASE_DRIVE_REFRESH_TOKEN_TTL_SECONDS=1209600
# EASE_DRIVE_REFRESH_GRACE_SECONDS=30
# EASE_DRIVE_MAX_FAILED_LOGINS=5
# EASE_DRIVE_LOCKOUT_SECONDS=900

# ---- CORS (required on any deployed host) ----
# Browser origins allowed to call this API. Comma-separated (a JSON array also
# works). No deployment hostname is hard-coded in the app, so a server that
# does not set this allows only http://localhost:3000 and http://127.0.0.1:3000
# and every request from a deployed frontend is blocked by the browser.
#
# Setting this REPLACES the default, so include localhost if you also develop
# against this host.
#
# List the origin the BROWSER is on, which is the frontend, not this backend's
# own URL. A trailing slash or a path is stripped automatically, because an
# Origin header carries neither and an exact-match allowlist would silently
# never match.
#
# Check what a running deploy resolved: curl .../api/v1/health -> .cors
EASE_DRIVE_CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
