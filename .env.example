# Copy to .env and fill in. .env is gitignored; never commit a real credential.
# Defaults for everything here live in app/core/config.py.

# ---- Database (required by any route that persists) ----
# Neon Postgres connection string. Unprefixed on purpose: Neon, Vercel, Render
# and Railway all inject this exact name, so the app reads it as-is.
# Without it the app still starts, /api/v1/health reports "degraded", and
# POST /api/v1/bookings returns 503 instead of crashing.
#
# Either endpoint works. The pooled one (-pooler in the host) is the default
# choice; the app detects it and disables asyncpg's prepared-statement cache,
# which PgBouncer's transaction mode cannot reuse safely.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"

# ---- Application (optional; all have defaults) ----
# EASE_DRIVE_PROJECT_NAME="Ease Drive API"
# EASE_DRIVE_VERSION="0.1.0"
# EASE_DRIVE_API_V1_PREFIX="/api/v1"
# EASE_DRIVE_GREETING="Hello, World!"

# Browser origins allowed to call the API. Add the deployed frontend origin
# here, or the browser blocks the booking POST before it reaches an endpoint.
# EASE_DRIVE_CORS_ORIGINS='["http://localhost:3000","https://ease-drive.example"]'
